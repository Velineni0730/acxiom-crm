@model IEnumerable<AcxiomCRM.Models.Opportunity>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Opportunities</h2>
        <p class="text-muted mb-0">Manage your sales pipeline and opportunities.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Opportunity
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th>Weighted Pipeline</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var opportunity in Model)
                {
                    <tr>
                        <td>@opportunity.OpportunityName</td>
                        <td>₹@opportunity.Amount</td>
                        <td>@opportunity.Stage</td>
                        <td>@opportunity.Probability%</td>
                        <td>@opportunity.ExpectedCloseDate.ToString("dd-MM-yyyy")</td>

                        <td>
                            @if (opportunity.Status == "Won")
                            {
                                <span class="badge bg-success">Won</span>
                            }
                            else if (opportunity.Status == "Lost")
                            {
                                <span class="badge bg-danger">Lost</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Active</span>
                            }
                        </td>

                        <td>
                            ₹@((opportunity.Amount * opportunity.Probability / 100).ToString("0.00"))
                        </td>

                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@opportunity.OpportunityId"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@opportunity.OpportunityId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@opportunity.OpportunityId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No opportunities found.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
