<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AcxiomCRM</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: 600;
        }

        .navbar-nav .nav-link {
            white-space: nowrap;
        }

        .page-container {
            max-width: 1250px;
            margin: 0 auto;
            padding: 32px 20px;
        }

        .table th {
            white-space: nowrap;
        }

        .btn {
            border-radius: 6px;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container-fluid px-4">

        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            AcxiomCRM
        </a>

        <div class="d-flex align-items-center ms-auto">

            <div class="navbar-nav align-items-center gap-1">

                <a class="nav-link" href="/Dashboard">Dashboard</a>
                <a class="nav-link" href="/Customers">Customers</a>
                <a class="nav-link" href="/Leads">Leads</a>
                <a class="nav-link" href="/Opportunities">Opportunities</a>
                <a class="nav-link" href="/FollowUps">Follow-Ups</a>
                <a class="nav-link" href="/Activities">Activities</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" href="/Admin">Admin</a>
                    <a class="nav-link" href="/UserManagement">Users & Roles</a>
                    <a class="nav-link" href="/AuditLogs">Audit Logs</a>
                }

                <div class="ms-3">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>
    </div>
</nav>

<main class="page-container">
    @RenderBody()
</main>

<footer class="border-top bg-white py-3">
    <div class="container text-muted small">
        AcxiomCRM
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
