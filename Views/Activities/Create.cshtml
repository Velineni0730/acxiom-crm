@model AcxiomCRM.Models.Activity

<h2>Add Activity</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="ActivityType" class="form-label"></label>
        <select asp-for="ActivityType" class="form-select">
            <option value="">Select Type</option>
            <option>Call</option>
            <option>Meeting</option>
            <option>Email</option>
            <option>Task</option>
        </select>
        <span asp-validation-for="ActivityType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="ActivityDate" class="form-label"></label>
        <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
