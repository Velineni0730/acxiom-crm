@model IEnumerable<AcxiomCRM.Models.FollowUp>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Follow-Ups</h2>
        <p class="text-muted mb-0">Manage scheduled and completed follow-ups.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Schedule Follow-Up
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Remarks</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var followUp in Model)
                {
                    <tr>
                        <td>
                            @followUp.FollowUpDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @followUp.FollowUpType
                        </td>

                        <td>
                            @followUp.Remarks
                        </td>

                        <td>
                            @if (followUp.Status == "Completed")
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (followUp.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Planned</span>
                            }
                        </td>

                        <td>
                            @followUp.AssignedTo
                        </td>

                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                @if (followUp.Status == "Planned")
                                {
                                    <form asp-action="Complete"
                                          method="post"
                                          class="m-0">
                                        <input type="hidden"
                                               name="id"
                                               value="@followUp.FollowUpId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Complete
                                        </button>
                                    </form>

                                    <form asp-action="Cancel"
                                          method="post"
                                          class="m-0">
                                        <input type="hidden"
                                               name="id"
                                               value="@followUp.FollowUpId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">No actions</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
